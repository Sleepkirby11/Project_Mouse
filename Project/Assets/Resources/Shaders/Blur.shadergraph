{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "30fe477601de4423a6763c69da985a23",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "ApplyBlur (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 134.0,
            "y": 104.66668701171875,
            "width": 210.6666259765625,
            "height": 150.66665649414063
        }
    },
    "m_Slots": [
        {
            "m_Id": "ac5d6cb81d3e46478121a39748fffa7d"
        },
        {
            "m_Id": "15d91d3045604dd0a36975ed142c74a3"
        },
        {
            "m_Id": "7b3b90e7bb1e47d79415c96cadaf2df6"
        },
        {
            "m_Id": "b03f227e756745cabd62acbfb7bef7df"
        },
        {
            "m_Id": "09e1fc30bda04569a237b5f998cf564f"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "ApplyBlur",
    "m_FunctionSource": "",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float4 col = float4(0, 0, 0, 0);\r\n\r\n// 3x3 가우시안 커널 가중치 (합계 = 16)\r\nfloat weights[9] = { 1, 2, 1, 2, 4, 2, 1, 2, 1 };\r\nfloat2 offsets[9] = {\r\n    float2(-1,  1), float2(0,  1), float2(1,  1),\r\n    float2(-1,  0), float2(0,  0), float2(1,  0),\r\n    float2(-1, -1), float2(0, -1), float2(1, -1)\r\n};\r\n\r\nfor (int i = 0; i < 9; i++)\r\n{\r\n    float2 sampleUV = UV + offsets[i] * BlurSize;\r\n    col += SAMPLE_TEXTURE2D(MainTex, Sampler, sampleUV) * weights[i];\r\n}\r\n\r\nOutColor = col / 16.0;\n"
}

